# Google Gemini API key, used server-side only (never sent to the browser).
# Required by:
#   - scripts/build-embeddings.mjs   (build time — regenerates the RAG index)
#   - src/pages/api/assistant.ts     (request time — the Study Assistant chat)
#
# Get a key at https://aistudio.google.com/apikey
# Copy this file to .env and fill in the real value. In Vercel, set the same
# name under Project Settings -> Environment Variables (Production + Preview).
GEMINI_API_KEY=
