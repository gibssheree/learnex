# ── Gemini API key ───────────────────────────────────────────────────────────
# Used server-side only (never sent to the browser).
# Required by:
#   - scripts/build-embeddings.mjs   (build time — regenerates the RAG index)
#   - src/pages/api/assistant.ts     (request time — the Study Assistant chat)
#
# Get a key at https://aistudio.google.com/apikey
# Copy this file to .env and fill in the real value. In Vercel, set the same
# name under Project Settings -> Environment Variables (Production + Preview).
GEMINI_API_KEY=

# ── Google Cloud Text-to-Speech API key ──────────────────────────────────────
# Used by src/pages/api/speak.ts for high-quality male voice synthesis.
# This is a DIFFERENT key from GEMINI_API_KEY — it must be a Cloud API key
# with the "Cloud Text-to-Speech API" enabled.
#
# Setup steps:
#   1. Go to console.cloud.google.com and open (or create) a project.
#   2. APIs & Services → Library → search "Cloud Text-to-Speech API" → Enable.
#   3. APIs & Services → Credentials → Create Credentials → API key.
#   4. (Optional) Restrict the key to the Text-to-Speech API for security.
#
# Voice used: en-US-Neural2-D (professional male, Neural2 tier).
# Pricing: ~$16 / 1M characters — well within free tier for personal use.
GOOGLE_TTS_API_KEY=

# ── Supabase (accounts, bookmarks/SRS/chat sync) ─────────────────────────────
# Public by design — safety comes entirely from Postgres Row-Level Security
# (auth.uid()-scoped policies in supabase/schema.sql), not from secrecy of
# this key. No service_role key is used anywhere in this app.
# Used by:
#   - src/lib/supabase-client.ts   (browser — sign-in/up, bookmarks/SRS sync)
#   - src/lib/supabase-server.ts   (src/pages/api/assistant.ts, request time)
#
# Setup steps:
#   1. Create a free project at https://supabase.com.
#   2. Project Settings -> API -> copy the Project URL and anon public key.
#   3. Paste supabase/schema.sql into SQL Editor -> New query -> run once.
#   4. (Recommended) Authentication -> Providers -> Email -> turn off "Confirm
#      email" for a personal-scale tool — one less support surface, reversible
#      anytime.
#
# Copy this file to .env and fill in the real values. In Vercel, set the same
# names under Project Settings -> Environment Variables (Production + Preview),
# then redeploy — Vercel does not retroactively apply new env vars to an
# existing build.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
