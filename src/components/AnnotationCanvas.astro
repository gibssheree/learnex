---
import AnnotationToolbar from './AnnotationToolbar.astro';

interface Props {
  route: string;
}
const { route } = Astro.props;
---

<div class="annotate-root" data-pagefind-ignore data-route={route}>
  <AnnotationToolbar id="annotate-toolbar" showExpandButton />
  <canvas id="annotate-canvas" class="annotate-canvas"></canvas>
</div>

<script>
  import { attachAnnotationToolkit } from '../lib/annotation-toolkit';

  const root = document.querySelector('.annotate-root') as HTMLElement | null;
  const canvas = document.getElementById('annotate-canvas') as HTMLCanvasElement | null;
  const toolbar = document.getElementById('annotate-toolbar');
  if (!root || !canvas || !toolbar) throw new Error('AnnotationCanvas: missing DOM nodes');

  const route = root.dataset.route ?? location.pathname;

  attachAnnotationToolkit({
    canvas,
    toolbar,
    root,
    storageKey: route,
    getActive: () => document.documentElement.getAttribute('data-ipad-mode') === 'on',
  });

  toolbar.querySelector('.annotate-expand-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('learnex:study-canvas-open', { detail: { route } }));
  });
</script>

<style>
  .annotate-root {
    position: absolute;
    inset: 0;
    z-index: 5;
    /* This wrapper spans the entire note body (inset: 0), sitting above
       .vault-prose in paint order. Without this, it silently captures every
       click/hover/text-selection across the whole note — even with no tool
       selected and outside iPad mode — because an absolutely positioned div
       defaults to pointer-events: auto. The toolbar
       (.annotate-toolbar--floating, shown only in iPad mode) and the canvas
       itself (toggled by annotation-toolkit.ts's syncInteractivity(), only
       while a drawing tool is active) each explicitly opt back into
       pointer-events: auto on themselves, so this doesn't block drawing or
       the toolbar — only restores normal interaction with the note text
       the rest of the time, which is the actual common case. */
    pointer-events: none;
  }
  .annotate-canvas {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    touch-action: none;
  }
</style>
