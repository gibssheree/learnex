---
interface Props {
  id: string;
  // 'floating' pins the toolbar as a pill above the note, shown only while
  // iPad mode is on (AnnotationCanvas's overlay-on-content use). 'inline'
  // sits in normal flow, always visible (the Study Canvas's own toolbar).
  variant?: 'floating' | 'inline';
  viewLabel?: string;
  showExpandButton?: boolean;
}

const { id, variant = 'floating', viewLabel = 'Read', showExpandButton = false } = Astro.props;
---

<div class:list={['annotate-toolbar', `annotate-toolbar--${variant}`]} id={id}>
  <button type="button" class="annotate-tool" data-tool="view" aria-pressed="true">{viewLabel}</button>
  <button type="button" class="annotate-tool" data-tool="pen" aria-pressed="false">Pen</button>
  <button type="button" class="annotate-tool" data-tool="pencil" aria-pressed="false">Pencil</button>
  <button type="button" class="annotate-tool" data-tool="highlighter" aria-pressed="false">Marker</button>
  <button type="button" class="annotate-tool" data-tool="eraser" aria-pressed="false">Eraser</button>
  <span class="annotate-divider"></span>
  <button type="button" class="annotate-color" data-color="var(--accent)" aria-label="Red ink" aria-pressed="true"></button>
  <button type="button" class="annotate-color" data-color="var(--brass)" aria-label="Brass ink" aria-pressed="false"></button>
  <button type="button" class="annotate-color" data-color="var(--ink)" aria-label="Ink black" aria-pressed="false"></button>
  <button type="button" class="annotate-color" data-color="#2f6f4e" aria-label="Forest ink" aria-pressed="false"></button>
  <button type="button" class="annotate-color" data-color="#2a5c8a" aria-label="Slate ink" aria-pressed="false"></button>
  <input type="color" class="annotate-color-picker" value="#5b3a29" aria-label="Custom ink color" title="Custom color" />
  <span class="annotate-divider"></span>
  <label class="annotate-size-label">Size</label>
  <input type="range" class="annotate-size" min="1" max="8" step="1" value="3" aria-label="Brush size" />
  <span class="annotate-divider"></span>
  <button type="button" class="annotate-tool annotate-undo-btn" aria-label="Undo last stroke">Undo</button>
  <button type="button" class="annotate-tool annotate-clear-btn">Clear</button>
  {showExpandButton && (
    <>
      <span class="annotate-divider"></span>
      <button type="button" class="annotate-tool annotate-expand-btn" aria-label="Open full-screen study canvas">Canvas ⤢</button>
    </>
  )}
</div>

<style>
  .annotate-toolbar {
    display: none;
  }
  :global([data-ipad-mode='on']) .annotate-toolbar--floating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    position: absolute;
    top: -1.1rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.6rem;
    box-shadow: 0 10px 24px -10px hsl(var(--shadow-color) / 0.6);
    z-index: 6;
    pointer-events: auto;
  }
  .annotate-toolbar--inline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  .annotate-tool {
    padding: 0.3rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    cursor: pointer;
  }
  .annotate-tool:hover {
    color: var(--ink);
  }
  .annotate-tool[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .annotate-divider {
    width: 1px;
    height: 16px;
    background: var(--border);
    flex-shrink: 0;
  }
  .annotate-color {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 999px;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
  }
  .annotate-color[aria-pressed='true'] {
    border-color: var(--ink);
  }
  .annotate-color-picker {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0;
    cursor: pointer;
    background: transparent;
  }
  .annotate-color-picker::-webkit-color-swatch-wrapper {
    padding: 0;
    border-radius: 999px;
  }
  .annotate-color-picker::-webkit-color-swatch {
    border: none;
    border-radius: 999px;
  }
  .annotate-size-label {
    font-family: var(--font-display);
    font-size: 0.68rem;
    color: var(--ink-muted);
    letter-spacing: 0.03em;
  }
  .annotate-size {
    width: 60px;
    accent-color: var(--accent);
  }

  @media (max-width: 640px) {
    :global([data-ipad-mode='on']) .annotate-toolbar--floating {
      top: -0.9rem;
      max-width: calc(100% - 1rem);
      justify-content: center;
    }
  }
</style>
