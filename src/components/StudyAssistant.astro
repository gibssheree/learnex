---
import PixelIcon from './ornaments/PixelIcon.astro';
---

<div class="assistant-root" data-pagefind-ignore>

  <!-- ─── Rolling caption strip — only in AI mode. The trigger button and its
       icon-swap states now live in Header.astro's toolbar (see
       #assistant-toggle-btn there); this component owns the panel/caption/
       messages that button controls. ──────────────────────────────────── -->
  <div id="assistant-caption-bar" class="assistant-caption-bar" hidden aria-live="polite" aria-atomic="true">
    <span id="assistant-caption-text" class="assistant-caption-text"></span>
  </div>

  <!-- ─── Chat panel — collapsed by default, header button toggles it ───── -->
  <section id="assistant-panel" class="assistant-panel" hidden aria-label="Study Assistant">
    <header class="assistant-header">
      <div class="assistant-header-row">
        <p class="font-pixel assistant-title">Study Assistant</p>
        <button
          id="assistant-settings-btn"
          class="assistant-settings-btn"
          type="button"
          aria-label="Pengaturan Study Assistant"
          aria-expanded="false"
          data-tooltip="Pengaturan"
        >
          <PixelIcon name="gear" size={13} />
        </button>
      </div>
      <p id="assistant-context" class="assistant-context"></p>
      <button id="assistant-close-btn" class="assistant-close" type="button" aria-label="Close Study Assistant">×</button>

      <div id="assistant-settings-panel" class="assistant-settings-panel" hidden>
        <label class="assistant-settings-row">
          <span>Gaya AI Tutor</span>
          <select id="assistant-persona-select" class="assistant-settings-select" aria-label="Gaya AI Tutor">
            <option value="direct">Direct</option>
            <option value="socratic">Socratic</option>
            <option value="encouraging">Encouraging</option>
          </select>
        </label>
        <label class="assistant-settings-row assistant-settings-checkbox-row">
          <input type="checkbox" id="assistant-local-toggle" />
          <span>Pakai model lokal (Ollama)</span>
        </label>
        <div id="assistant-local-fields" class="assistant-local-fields" hidden>
          <input
            type="text"
            id="assistant-local-model-input"
            class="assistant-settings-text"
            placeholder="Nama model, mis. llama3.2"
            aria-label="Nama model Ollama"
          />
          <p class="assistant-settings-hint">
            Butuh Ollama jalan di <code>localhost:11434</code>. Saat aktif, pertanyaan tidak lewat
            server Learnitas sama sekali dan pencarian vault (RAG) nonaktif. Kalau muncul error CORS,
            jalankan Ollama dengan env <code>OLLAMA_ORIGINS=*</code>.
          </p>
        </div>
      </div>
    </header>

    <div id="assistant-messages" class="assistant-messages">
      <p class="assistant-empty">
        Ask about anything in the vault — I'll search the notes for you rather than guess.
      </p>
    </div>

    <div id="assistant-login-gate" class="assistant-login-gate" hidden>
      <p>Log in to use the Study Assistant.</p>
      <button id="assistant-login-gate-btn" class="assistant-login-gate-btn" type="button">Log in</button>
    </div>

    <form id="assistant-form" class="assistant-form">
      <button
        id="assistant-mic-btn"
        class="assistant-mic"
        type="button"
        aria-label="AI mode"
        data-tooltip="AI mode"
        data-tooltip-pos="top"
        hidden
      >
        <PixelIcon name="mic" size={15} />
      </button>
      <textarea
        id="assistant-input"
        class="assistant-input"
        placeholder="Ask a question…"
        rows="1"
        aria-label="Message"
      ></textarea>
      <button id="assistant-send-btn" class="assistant-send" type="submit" aria-label="Send">
        <PixelIcon name="send" size={16} />
      </button>
    </form>
  </section>
</div>

<template id="assistant-speak-icon-tpl"><PixelIcon name="speaker" size={12} /></template>

<script>
  import { isPersona, PERSONA_INSTRUCTIONS, DIAGRAM_INSTRUCTION, type Persona } from '../lib/ai-personas';
  import { renderDiagramSvg } from '../lib/diagram';
  import { getCurrentUserId } from '../lib/auth-client';
  import { supabase } from '../lib/supabase-client';

  // `local: true` marks a message exchanged while the local-Ollama (BYOC)
  // path was active — see getAssistantReply()'s filter below, which keeps
  // those turns out of what's sent to /api/assistant so a switch back to
  // hosted mode mid-conversation can't leak a local-only exchange into the
  // synced, server-persisted chat history.
  interface ChatMessage { role: 'user' | 'model'; text: string; local?: boolean; }

  const toggleBtn    = document.getElementById('assistant-toggle-btn') as HTMLButtonElement | null;
  const closeBtn     = document.getElementById('assistant-close-btn');
  const panel        = document.getElementById('assistant-panel');
  const messagesEl   = document.getElementById('assistant-messages');
  const contextEl    = document.getElementById('assistant-context');
  const form         = document.getElementById('assistant-form') as HTMLFormElement | null;
  const input        = document.getElementById('assistant-input') as HTMLTextAreaElement | null;
  const sendBtn      = document.getElementById('assistant-send-btn') as HTMLButtonElement | null;
  const micBtn       = document.getElementById('assistant-mic-btn') as HTMLButtonElement | null;
  const speakIconTpl = document.getElementById('assistant-speak-icon-tpl') as HTMLTemplateElement | null;
  const loginGate    = document.getElementById('assistant-login-gate') as HTMLElement | null;
  const loginGateBtn = document.getElementById('assistant-login-gate-btn');
  // Trigger button + its state icons now live in Header.astro's toolbar;
  // toggleBtn (above) IS what used to be the separate fabWrap element —
  // data-ai-state lives directly on the button now, no wrapper needed.
  const captionBar   = document.getElementById('assistant-caption-bar');
  const captionText  = document.getElementById('assistant-caption-text');

  const fabIconChat    = document.getElementById('fab-icon-chat');
  const fabIconMic     = document.getElementById('fab-icon-mic');
  const fabIconSpeaker = document.getElementById('fab-icon-speaker');
  const fabIconSpinner = document.getElementById('fab-icon-spinner');

  const history: ChatMessage[] = [];
  let aiModeActive = false;
  let captionTimer: ReturnType<typeof setInterval> | null = null;

  // ── Persona & local-model (BYOC) settings ─────────────────────────────────

  const PERSONA_KEY = 'learnitas-ai-persona';
  const LOCAL_KEY = 'learnitas-ai-local';

  const storedPersona = localStorage.getItem(PERSONA_KEY);
  let persona: Persona = isPersona(storedPersona) ? storedPersona : 'direct';

  interface LocalModelSettings { enabled: boolean; model: string; }
  function loadLocalSettings(): LocalModelSettings {
    try {
      const raw = JSON.parse(localStorage.getItem(LOCAL_KEY) ?? '{}');
      return { enabled: !!raw.enabled, model: typeof raw.model === 'string' && raw.model ? raw.model : 'llama3.2' };
    } catch {
      return { enabled: false, model: 'llama3.2' };
    }
  }
  const localSettings: LocalModelSettings = loadLocalSettings();
  function saveLocalSettings() {
    localStorage.setItem(LOCAL_KEY, JSON.stringify(localSettings));
  }

  const settingsBtn    = document.getElementById('assistant-settings-btn');
  const settingsPanel  = document.getElementById('assistant-settings-panel');
  const personaSelect  = document.getElementById('assistant-persona-select') as HTMLSelectElement | null;
  const localToggle    = document.getElementById('assistant-local-toggle') as HTMLInputElement | null;
  const localFields    = document.getElementById('assistant-local-fields') as HTMLElement | null;
  const localModelInput = document.getElementById('assistant-local-model-input') as HTMLInputElement | null;

  if (personaSelect) personaSelect.value = persona;
  if (localToggle) localToggle.checked = localSettings.enabled;
  if (localModelInput) localModelInput.value = localSettings.model;
  if (localFields) localFields.hidden = !localSettings.enabled;

  settingsBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = settingsPanel ? !settingsPanel.hidden : false;
    if (settingsPanel) settingsPanel.hidden = isOpen;
    settingsBtn.setAttribute('aria-expanded', String(!isOpen));
  });
  document.addEventListener('click', (e) => {
    if (!settingsPanel || settingsPanel.hidden) return;
    if (!(e.target as HTMLElement).closest?.('#assistant-settings-panel, #assistant-settings-btn')) {
      settingsPanel.hidden = true;
      settingsBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  personaSelect?.addEventListener('change', () => {
    if (isPersona(personaSelect.value)) {
      persona = personaSelect.value;
      localStorage.setItem(PERSONA_KEY, persona);
    }
  });

  localToggle?.addEventListener('change', () => {
    localSettings.enabled = localToggle.checked;
    if (localFields) localFields.hidden = !localSettings.enabled;
    saveLocalSettings();
    syncLoginGate();
  });

  localModelInput?.addEventListener('change', () => {
    localSettings.model = localModelInput.value.trim() || 'llama3.2';
    saveLocalSettings();
  });

  // ── Login gate ────────────────────────────────────────────────────────────
  // Hosted mode (Gemini via /api/assistant) requires login; local-Ollama mode
  // never touches the server and stays usable while logged out.

  function requiresLogin(): boolean {
    return !localSettings.enabled && !getCurrentUserId();
  }

  function syncLoginGate() {
    const gated = requiresLogin();
    if (loginGate) loginGate.hidden = !gated;
    if (form) form.hidden = gated;
  }

  loginGateBtn?.addEventListener('click', () => {
    document.getElementById('auth-toggle-btn')?.click();
  });

  // ── Persisted history — loaded once per page load, first time a
  // learnitas:auth-changed event carries a signed-in user and nothing has
  // been typed yet (guards against clobbering an in-progress local-mode
  // conversation that started before the session check resolved). ────────

  let historyLoaded = false;

  async function maybeLoadHistory(userId: string | null) {
    if (historyLoaded || !userId || history.length > 0) return;
    historyLoaded = true;
    const { data, error } = await supabase
      .from('assistant_threads')
      .select('messages')
      .eq('user_id', userId)
      .maybeSingle();
    if (error || !data?.messages) return;
    const saved = data.messages as ChatMessage[];
    for (const m of saved) {
      if (!m || (m.role !== 'user' && m.role !== 'model') || typeof m.text !== 'string') continue;
      history.push(m);
      appendMessage(m.role, m.text);
    }
  }

  document.addEventListener('learnitas:auth-changed', (e) => {
    syncLoginGate();
    const detail = (e as CustomEvent).detail as { userId: string | null } | undefined;
    if (detail?.userId) maybeLoadHistory(detail.userId);
  });

  syncLoginGate();

  // ── helpers ───────────────────────────────────────────────────────────────

  function currentPage() {
    const h1 = document.querySelector('.reader-header h1, .page-leaf-inner h1');
    const title = h1?.textContent?.trim() || document.title.replace(/\s*·\s*Learnitas$/, '');
    return { title, route: location.pathname };
  }

  function showFabIcon(which: 'chat' | 'mic' | 'speaker' | 'spinner') {
    fabIconChat!.hidden    = which !== 'chat';
    fabIconMic!.hidden     = which !== 'mic';
    fabIconSpeaker!.hidden = which !== 'speaker';
    fabIconSpinner!.hidden = which !== 'spinner';
  }

  // ── Markdown renderer — no external dep, XSS-safe ────────────────────────
  // Escapes HTML entities first, then applies block & inline transformations.

  const escAttr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');

  /** Renders a ```learnitas-diagram fenced block (JSON, see ai-personas.ts's
   * DIAGRAM_INSTRUCTION) as inline SVG via the shared layout in lib/diagram.ts,
   * plus a button that hands the same spec to Study Canvas as a non-destructive
   * overlay — see the `learnitas:assistant-diagram` listener in StudyCanvas.astro. */
  function renderDiagramBlock(raw: string): string {
    try {
      const spec = JSON.parse(raw);
      const svg = renderDiagramSvg(spec);
      if (!svg) throw new Error('empty diagram');
      const hasCanvas = !!document.getElementById('study-canvas-overlay');
      const openBtn = hasCanvas
        ? `<button type="button" class="assistant-diagram-open-btn" data-diagram="${escAttr(JSON.stringify(spec))}">Buka di Study Canvas</button>`
        : '';
      return `<div class="assistant-diagram">${svg}${openBtn}</div>`;
    } catch {
      return '<p class="assistant-diagram-error">(Diagram tidak bisa ditampilkan)</p>';
    }
  }

  function renderMarkdown(raw: string): string {
    // Escape HTML to prevent XSS (applied before markdown transforms)
    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    // Inline: applied to already-escaped text inside block elements
    const inline = (s: string) =>
      s
        // inline code
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        // bold
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        // italic (single *, not adjacent to another *)
        .replace(/(?<!\*)\*(?!\*)([^*\n]+)(?<!\*)\*(?!\*)/g, '<em>$1</em>');

    const lines = raw.split('\n');
    const out: string[] = [];
    let inCode = false;
    let codeLang = '';
    let codeBuf: string[] = [];
    let listType: 'ul' | 'ol' | null = null;

    const closeList = () => {
      if (listType) { out.push(`</${listType}>`); listType = null; }
    };
    const flushCode = () => {
      out.push(
        codeLang === 'learnitas-diagram'
          ? renderDiagramBlock(codeBuf.join('\n'))
          : `<pre><code>${esc(codeBuf.join('\n'))}</code></pre>`,
      );
      codeBuf = [];
      codeLang = '';
    };

    for (const line of lines) {
      // ── code fence ──
      let fence: RegExpMatchArray | null;
      if ((fence = line.match(/^```\s*(\S*)/))) {
        if (inCode) {
          flushCode();
          inCode = false;
        } else {
          closeList(); inCode = true; codeLang = fence[1] ?? '';
        }
        continue;
      }
      if (inCode) { codeBuf.push(line); continue; }

      let m: RegExpMatchArray | null;

      // ── headings ──
      if ((m = line.match(/^### (.+)/))) { closeList(); out.push(`<h3>${inline(esc(m[1]))}</h3>`); continue; }
      if ((m = line.match(/^## (.+)/)))  { closeList(); out.push(`<h2>${inline(esc(m[1]))}</h2>`); continue; }
      if ((m = line.match(/^# (.+)/)))   { closeList(); out.push(`<h1>${inline(esc(m[1]))}</h1>`); continue; }

      // ── unordered list ──
      if ((m = line.match(/^[*\-] (.+)/))) {
        if (listType === 'ol') { out.push('</ol>'); listType = null; }
        if (!listType) { out.push('<ul>'); listType = 'ul'; }
        out.push(`<li>${inline(esc(m[1]))}</li>`);
        continue;
      }

      // ── ordered list ──
      if ((m = line.match(/^\d+\.\s+(.+)/))) {
        if (listType === 'ul') { out.push('</ul>'); listType = null; }
        if (!listType) { out.push('<ol>'); listType = 'ol'; }
        out.push(`<li>${inline(esc(m[1]))}</li>`);
        continue;
      }

      // ── blank line (paragraph break) ──
      if (line.trim() === '') { closeList(); continue; }

      // ── regular paragraph ──
      closeList();
      out.push(`<p>${inline(esc(line))}</p>`);
    }

    closeList();
    if (inCode) flushCode();

    return out.join('\n');
  }

  // ── Panel open/close (only when NOT in AI mode) ───────────────────────────

  function setPanelOpen(open: boolean) {
    if (!panel || !toggleBtn) return;
    panel.hidden = !open;
    toggleBtn.setAttribute('aria-expanded', String(open));
    if (open) {
      if (contextEl) contextEl.textContent = currentPage().title;
      input?.focus();
    }
  }

  toggleBtn?.addEventListener('click', () => {
    if (aiModeActive) {
      // In AI mode, a tap = tap to talk
      const state = toggleBtn?.dataset.aiState;
      if (state === 'listening') stopListening();
      else if (state === 'idle')  startListening();
    } else {
      setPanelOpen(panel?.hidden !== false);
    }
  });

  closeBtn?.addEventListener('click', () => setPanelOpen(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (aiModeActive) exitAiMode();
    else if (panel && !panel.hidden) setPanelOpen(false);
  });

  // ── AI orb state ──────────────────────────────────────────────────────────

  type AiState = 'idle' | 'listening' | 'thinking' | 'speaking';

  function setOrbState(state: AiState) {
    if (!toggleBtn) return;
    toggleBtn.dataset.aiState = state;

    if (state === 'listening')     showFabIcon('mic');
    else if (state === 'thinking') showFabIcon('spinner');
    else if (state === 'speaking') showFabIcon('speaker');
    else                           showFabIcon('chat');

    toggleBtn?.setAttribute('aria-label',
      state === 'listening' ? 'Tap to stop' :
      state === 'thinking'  ? 'Thinking…'   :
      state === 'speaking'  ? 'Speaking…'   :
      'Tap to talk');

    // Show status as caption when idle in AI mode
    if (state === 'idle') setCaption('Tap to talk…', false);
  }

  // ── Rolling caption (5-6 word chunks that cycle) ──────────────────────────
  // Text flows left of the FAB in short bursts, like Siri/Google Assistant.

  function setCaption(text: string, rolling = true) {
    if (!captionBar || !captionText) return;
    captionBar.hidden = false;

    stopCaptionTimer();

    if (!rolling || !text) {
      captionText.dataset.fade = 'in';
      captionText.textContent = text;
      return;
    }

    // Split into 5-word chunks
    const words = text.split(/\s+/).filter(Boolean);
    const size = 5;
    const chunks: string[] = [];
    for (let i = 0; i < words.length; i += size) {
      chunks.push(words.slice(i, i + size).join(' '));
    }
    if (chunks.length === 0) return;

    let idx = 0;
    const show = (chunk: string) => {
      // Fade out → swap text → fade in
      captionText!.dataset.fade = 'out';
      setTimeout(() => {
        captionText!.textContent = chunk;
        captionText!.dataset.fade = 'in';
      }, 280);
    };

    show(chunks[0]);
    if (chunks.length > 1) {
      captionTimer = setInterval(() => {
        idx = (idx + 1) % chunks.length;
        show(chunks[idx]);
      }, 2000);
    }
  }

  function stopCaptionTimer() {
    if (captionTimer !== null) { clearInterval(captionTimer); captionTimer = null; }
  }

  function hideCaption() {
    stopCaptionTimer();
    if (captionBar) captionBar.hidden = true;
    if (captionText) captionText.textContent = '';
  }

  // ── Enter / exit AI mode ──────────────────────────────────────────────────

  function enterAiMode() {
    if (!recognition || !toggleBtn) return;
    aiModeActive = true;

    // Collapse the chat panel — the toolbar button is now the voice orb
    setPanelOpen(false);
    toggleBtn?.removeAttribute('data-tooltip');

    setOrbState('idle');
    startListening();
  }

  function exitAiMode() {
    aiModeActive = false;
    stopListening();
    currentAudio?.pause();
    stopCaptionTimer();

    delete toggleBtn!.dataset.aiState;
    showFabIcon('chat');
    hideCaption();

    toggleBtn?.setAttribute('data-tooltip', 'Study Assistant');
    toggleBtn?.setAttribute('aria-label', 'Open Study Assistant');
    toggleBtn?.setAttribute('aria-expanded', 'false');
  }

  // ── Messages ──────────────────────────────────────────────────────────────

  function appendMessage(role: ChatMessage['role'], text: string) {
    if (!messagesEl) return;
    messagesEl.querySelector('.assistant-empty')?.remove();
    const row = document.createElement('div');
    row.className = `assistant-msg assistant-msg--${role}`;
    const textEl = document.createElement('div');
    textEl.className = 'assistant-msg-text';
    if (role === 'model') {
      // Render markdown for model replies; user messages display as plain text
      textEl.innerHTML = renderMarkdown(text);
    } else {
      textEl.textContent = text;
    }
    row.appendChild(textEl);
    messagesEl.appendChild(row);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return row;
  }

  // Delegated (not per-button) since diagram buttons are created dynamically
  // by renderMarkdown() well after this listener is attached.
  messagesEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.assistant-diagram-open-btn');
    if (!btn?.dataset.diagram) return;
    try {
      document.dispatchEvent(new CustomEvent('learnitas:assistant-diagram', { detail: JSON.parse(btn.dataset.diagram) }));
    } catch { /* malformed spec — nothing to open */ }
  });

  // ── TTS ───────────────────────────────────────────────────────────────────

  let currentAudio: HTMLAudioElement | null = null;

  async function speak(text: string, triggerBtn?: HTMLButtonElement | null): Promise<void> {
    currentAudio?.pause();
    if (triggerBtn) triggerBtn.disabled = true;
    try {
      const res = await fetch('/api/speak', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });
      const data = await res.json();
      if (!res.ok || !data.audioBase64) return;
      currentAudio = new Audio(`data:${data.mimeType};base64,${data.audioBase64}`);
      await new Promise<void>((resolve) => {
        currentAudio!.addEventListener('ended', () => resolve(), { once: true });
        currentAudio!.addEventListener('error', () => resolve(), { once: true });
        currentAudio!.play().catch(() => resolve());
      });
    } catch { /* voice is a bonus — fail quietly */ }
    finally { if (triggerBtn) triggerBtn.disabled = false; }
  }

  function addSpeakButton(row: HTMLElement | null | undefined, text: string) {
    if (!row || !speakIconTpl) return;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'assistant-msg-speak';
    btn.setAttribute('aria-label', 'Read this reply aloud');
    btn.appendChild(speakIconTpl.content.cloneNode(true));
    btn.addEventListener('click', () => speak(text, btn));
    row.appendChild(btn);
  }

  // ── Speech recognition ────────────────────────────────────────────────────

  const SpeechRecognitionImpl = (window as any).SpeechRecognition ?? (window as any).webkitSpeechRecognition;
  let recognition: any = null;
  let listening = false;

  function startListening() {
    if (!recognition || listening) return;
    listening = true;
    setOrbState('listening');
    setCaption('Listening…', false);
    try { recognition.start(); }
    catch { listening = false; setOrbState('idle'); }
  }

  function stopListening() {
    if (!recognition || !listening) return;
    recognition.stop();
  }

  if (SpeechRecognitionImpl && micBtn) {
    micBtn.hidden = false;
    recognition = new SpeechRecognitionImpl();
    recognition.lang = document.documentElement.lang || 'en-US';
    recognition.interimResults = true;   // show partial transcript while speaking
    recognition.maxAlternatives = 1;

    recognition.addEventListener('result', (e: any) => {
      const result = e.results?.[e.results.length - 1];
      const transcript: string = result?.[0]?.transcript?.trim() ?? '';
      const isFinal: boolean = result?.isFinal ?? false;

      // Stream interim words as rolling caption while user is speaking
      if (transcript) setCaption(transcript, false);

      if (isFinal && transcript && input) {
        stopCaptionTimer();
        if (aiModeActive) {
          setOrbState('thinking');
          setCaption('Thinking…', false);
        }
        input.value = transcript;
        form?.requestSubmit();
      }
    });

    recognition.addEventListener('end', () => {
      listening = false;
      if (aiModeActive && toggleBtn?.dataset.aiState === 'listening') setOrbState('idle');
    });
    recognition.addEventListener('error', () => {
      listening = false;
      if (aiModeActive) setOrbState('idle');
    });

    micBtn.addEventListener('click', enterAiMode);
  }

  // ── Auto-grow textarea ────────────────────────────────────────────────────

  input?.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
  });

  // ── Local model (Ollama BYOC) ───────────────────────────────────────────
  // Talks straight to the user's own Ollama instance from the browser —
  // never touches /api/assistant. No search_vault tool call here: doing
  // retrieval privately would mean either embedding the query via Gemini
  // (defeating the point of "local") or requiring a locally-pulled embedding
  // model too, so this mode intentionally answers from the local model's own
  // general knowledge rather than the vault.

  async function askLocalModel(hist: ChatMessage[], page: { title: string; route: string }): Promise<string> {
    const sys = [
      'You are the Learnitas Study Assistant, running on a local model the user chose for privacy. You do not have access to the Learnitas vault search tool in this mode — answer from your own knowledge and say so plainly if unsure rather than inventing vault-specific details.',
      PERSONA_INSTRUCTIONS[persona],
      DIAGRAM_INSTRUCTION,
      `The user is currently reading: "${page.title}" (${page.route}).`,
    ].join('\n');

    const res = await fetch('http://localhost:11434/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: localSettings.model,
        stream: false,
        messages: [
          { role: 'system', content: sys },
          ...hist.map((m) => ({ role: m.role === 'model' ? 'assistant' : 'user', content: m.text })),
        ],
      }),
    });
    if (!res.ok) throw new Error(`Ollama HTTP ${res.status} — is it running at localhost:11434?`);
    const data = await res.json();
    const content = data?.message?.content;
    if (!content) throw new Error('Ollama returned an empty reply.');
    return content as string;
  }

  async function getAssistantReply(): Promise<string> {
    if (localSettings.enabled) return askLocalModel(history, currentPage());
    // Local-mode turns never leave the browser and must not leak into the
    // synced, server-persisted thread — see the `local` field on ChatMessage.
    const res = await fetch('/api/assistant', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        messages: history.filter((m) => !m.local).map(({ role, text }) => ({ role, text })),
        currentPage: currentPage(),
        persona,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error ?? 'Something went wrong.');
    return data.text ?? 'No answer came back.';
  }

  // ── Submit ────────────────────────────────────────────────────────────────

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input?.value.trim();
    if (!text || !input || !sendBtn) return;

    appendMessage('user', text);
    history.push({ role: 'user', text, local: localSettings.enabled });
    input.value = '';
    input.style.height = 'auto';
    sendBtn.disabled = true;

    const pending = appendMessage('model', 'Thinking…');
    pending?.classList.add('assistant-msg--pending');

    try {
      const answer = await getAssistantReply();
      const pendingText = pending?.querySelector<HTMLElement>('.assistant-msg-text');
      if (pendingText) pendingText.innerHTML = renderMarkdown(answer);
      pending?.classList.remove('assistant-msg--pending');

      history.push({ role: 'model', text: answer, local: localSettings.enabled });
      addSpeakButton(pending, answer);
      if (aiModeActive) {
        setOrbState('speaking');
        setCaption(answer, true);  // rolling 5-word chunks while speaking
        await speak(answer);
        if (aiModeActive) {
          stopCaptionTimer();
          setOrbState('idle');
        }
      }
    } catch (err) {
      const message = err instanceof Error ? err.message : "Couldn't reach the assistant — check your connection.";
      const pendingText = pending?.querySelector<HTMLElement>('.assistant-msg-text');
      if (pendingText) pendingText.textContent = message;
      pending?.classList.remove('assistant-msg--pending');
      pending?.classList.add('assistant-msg--error');
      if (aiModeActive) setOrbState('idle');
    } finally {
      sendBtn.disabled = false;
    }
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form?.requestSubmit(); }
  });
</script>

