---
// A tiny retro pixel diorama for the header's trailing blank space: two kids
// reading in the grass, a rabbit, a bird overhead. Same hand-authored
// rect-grid technique as PixelIcon/Medallion, just multi-color and composed
// into one scene. Idle is fully static; hover wakes the bird and rabbit only.

const PALETTE: Record<string, string> = {
  S: '#e8b98a', // skin
  H: '#5b3a22', // hair
  K: '#221a10', // eyes / outline
  C: '#8a1526', // shirt, child A (site crimson)
  c: '#3a5a8c', // shirt, child B (site blue)
  B: '#7c4a2d', // book cover
  b: '#f2e8d3', // book pages / rabbit & bird belly
  W: '#f2e8d3', // rabbit body
  P: '#e79aa5', // rabbit ears
  O: '#c9a75c', // bird (site brass)
};

const RABBIT = [
  '...PP...',
  '...PP...',
  '..WWWW..',
  '.WWWWWW.',
  'WWWWWWWK',
  'WWWWWWW.',
  '.WW..WW.',
  '........',
];

const BIRD = [
  '...OO...',
  '..OOOO..',
  '.OOOOOK.',
  'OOOOOO..',
  '..O..O..',
  '........',
];

const SITTING_CHILD = [
  '...HHH....',
  '..HHHHH...',
  '..SSSSS...',
  '..SKSKS...',
  '..SSSSS...',
  '...SSS....',
  '..CCCCC...',
  '.CCCCCCC..',
  '.CCCCCCC..',
  'CC.....CC.',
  'CC.....CC.',
  '..........',
];

const STANDING_CHILD = [
  '....HHH...',
  '...HHHHH..',
  '...SSSSS..',
  '...SKSKS..',
  '...SSSSS..',
  '....SSS...',
  '...ccccc..',
  '..bBBBBb..',
  '..BbbbBb..',
  '..bBBBBb..',
  '...ccccc..',
  '...cc.cc..',
  '...cc.cc..',
  '...cc.cc..',
  '...cc.cc..',
  '..........',
];

interface Cell {
  x: number;
  y: number;
  fill: string;
}

function toCells(grid: string[], originX: number, originY: number, cell: number): Cell[] {
  const cells: Cell[] = [];
  grid.forEach((row, ry) => {
    row.split('').forEach((ch, rx) => {
      const fill = PALETTE[ch];
      if (!fill) return;
      cells.push({ x: originX + rx * cell, y: originY + ry * cell, fill });
    });
  });
  return cells;
}

const CELL = 1.9;
const BASELINE = 40;

const sittingCells = toCells(SITTING_CHILD, 4, BASELINE - 12 * CELL, CELL);
const rabbitCells = toCells(RABBIT, 27, BASELINE - 8 * CELL, CELL);
const standingCells = toCells(STANDING_CHILD, 48, BASELINE - 16 * CELL, CELL);
const birdCells = toCells(BIRD, 77, 2, CELL);

const grassTufts = Array.from({ length: 14 }, (_, i) => {
  const x = 2 + i * 7.6;
  const h = i % 3 === 0 ? 5 : 3.5;
  return { x, h };
});
---

<div class="navbar-scene" data-tooltip="A quiet reading corner" data-tooltip-pos="bottom">
  <svg viewBox="0 0 108 46" class="navbar-scene-svg" role="img" aria-label="A rabbit and a bird watch two children reading in the grass">
    <g class="scene-ground">
      <rect x="0" y="40" width="108" height="6" fill="#3f6b28" />
      {grassTufts.map((t) => (
        <rect x={t.x} y={40 - t.h} width="2" height={t.h} fill="#5a8a3c" />
      ))}
    </g>

    <g class="scene-sitting-child">
      {sittingCells.map((c) => (
        <rect x={c.x} y={c.y} width={CELL} height={CELL} fill={c.fill} />
      ))}
    </g>

    <g class="scene-rabbit">
      {rabbitCells.map((c) => (
        <rect x={c.x} y={c.y} width={CELL} height={CELL} fill={c.fill} />
      ))}
    </g>

    <g class="scene-standing-child">
      {standingCells.map((c) => (
        <rect x={c.x} y={c.y} width={CELL} height={CELL} fill={c.fill} />
      ))}
    </g>

    <g class="scene-bird">
      {birdCells.map((c) => (
        <rect x={c.x} y={c.y} width={CELL} height={CELL} fill={c.fill} />
      ))}
    </g>
  </svg>
</div>

<style>
  .navbar-scene {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .navbar-scene-svg {
    height: 38px;
    width: auto;
    display: block;
    shape-rendering: crispEdges;
  }

  .scene-bird {
    transform-box: fill-box;
    transform-origin: center;
    animation: bird-bob 1.1s ease-in-out infinite;
    animation-play-state: paused;
  }
  .scene-rabbit {
    transform-box: fill-box;
    transform-origin: bottom center;
    animation: rabbit-hop 0.6s ease-in-out infinite;
    animation-play-state: paused;
  }
  .navbar-scene:hover .scene-bird,
  .navbar-scene:hover .scene-rabbit {
    animation-play-state: running;
  }

  @keyframes bird-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3.5px); }
  }
  @keyframes rabbit-hop {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-2.5px); }
    60% { transform: translateY(-2.5px); }
  }

  @media (max-width: 1220px) {
    .navbar-scene {
      display: none;
    }
  }
</style>
