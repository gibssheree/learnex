---
import { getCollection, type CollectionEntry } from 'astro:content';
import { DOMAIN_GROUPS, KNOWLEDGE_DOMAINS, LANGUAGE_CATEGORY_ORDER, LANGUAGE_CATEGORY_LABELS } from '../lib/domainGroups';
import { iconForDomain } from '../lib/pixelIcons';
import PixelIcon from './ornaments/PixelIcon.astro';

const terms = await getCollection('terms');
const languages = await getCollection('languages');
const knowledge = await getCollection('knowledge');

const domainSlugByName = new Map<string, string>();
for (const t of terms) domainSlugByName.set(t.data.domain, t.data.domainSlug);

const knowledgeDomainSlugByName = new Map<string, string>();
const knowledgeNotesByDomain = new Map<string, CollectionEntry<'knowledge'>[]>();
for (const k of knowledge) {
  knowledgeDomainSlugByName.set(k.data.domain, k.data.domainSlug);
  if (k.data.isMoc) continue;
  if (!knowledgeNotesByDomain.has(k.data.domain)) knowledgeNotesByDomain.set(k.data.domain, []);
  knowledgeNotesByDomain.get(k.data.domain)!.push(k);
}
for (const list of knowledgeNotesByDomain.values()) {
  list.sort((a, b) => a.data.title.localeCompare(b.data.title));
}

const languagesByCategory = new Map<string, CollectionEntry<'languages'>[]>();
for (const l of languages) {
  if (l.data.isMoc) continue;
  const cat = l.data.category ?? 'Niche';
  if (!languagesByCategory.has(cat)) languagesByCategory.set(cat, []);
  languagesByCategory.get(cat)!.push(l);
}
for (const list of languagesByCategory.values()) {
  list.sort((a, b) => a.data.title.localeCompare(b.data.title));
}

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => currentPath === href;
const inLanguages = currentPath.startsWith('/languages');
const inTerms = currentPath.startsWith('/terms');
const inKnowledgeDomain = (slug: string) => currentPath === `/${slug}` || currentPath.startsWith(`/${slug}/`);
---

<nav class="sidebar" aria-label="Primary">
  <details class="nav-group" open={inLanguages || !inTerms}>
    <summary><PixelIcon name="scroll" size={15} /> <span>Programming Languages</span></summary>
    <div class="nav-group-body">
      <a class="nav-hub-link" href="/languages" aria-current={isActive('/languages') ? 'page' : undefined}>
        Overview &amp; Mind Map
      </a>
      {LANGUAGE_CATEGORY_ORDER.map((cat) => (
        <details class="nav-subgroup">
          <summary>{LANGUAGE_CATEGORY_LABELS[cat]}</summary>
          <ul>
            {(languagesByCategory.get(cat) ?? []).map((l) => {
              const href = `/languages/${l.data.slug}`;
              return (
                <li>
                  <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                    {l.data.title}
                    {l.data.status === 'known' && (
                      <i class="known-dot" role="img" aria-label="Marked known by the author" data-tooltip="Marked known by the author" />
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      ))}
    </div>
  </details>

  <details class="nav-group" open={inTerms}>
    <summary><PixelIcon name="book" size={15} /> <span>Terms &amp; Knowledge</span></summary>
    <div class="nav-group-body">
      {DOMAIN_GROUPS.map((group) => (
        <details class="nav-subgroup">
          <summary>{group.title}</summary>
          <ul>
            {group.domains.map((domain) => {
              const slug = domainSlugByName.get(domain);
              const href = `/terms/${slug}`;
              return (
                <li>
                  <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                    <PixelIcon name={iconForDomain(domain)} size={13} />
                    <span>{domain}</span>
                    <span class="sidebar-mastery-badge" data-mastery-key={slug} hidden data-tooltip="Semua catatan di domain ini sudah dikuasai">
                      <PixelIcon name="badge" size={11} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      ))}
    </div>
  </details>

  {KNOWLEDGE_DOMAINS.map((domain) => {
    const slug = knowledgeDomainSlugByName.get(domain);
    const notes = knowledgeNotesByDomain.get(domain) ?? [];
    if (!slug || notes.length === 0) return null;
    return (
      <details class="nav-group" open={inKnowledgeDomain(slug)}>
        <summary>
          <PixelIcon name={iconForDomain(domain)} size={15} /> <span>{domain}</span>
          <span class="sidebar-mastery-badge" data-mastery-key={slug} hidden data-tooltip="Semua catatan di domain ini sudah dikuasai">
            <PixelIcon name="badge" size={11} />
          </span>
        </summary>
        <div class="nav-group-body">
          <ul class="knowledge-list">
            {notes.map((note) => {
              const href = `/${slug}/${note.data.slug}`;
              return (
                <li>
                  <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                    <span>{note.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </details>
    );
  })}
</nav>

<script>
  import { loadStates } from '../lib/srs-client';
  import { computeGroupProgress, type MasteryIndex } from '../lib/mastery';

  // Decorative-only: badges are a nice-to-have read of localStorage state,
  // never load-bearing for navigation — any failure here is swallowed so a
  // slow/broken fetch never breaks the sidebar itself.
  (async () => {
    try {
      const res = await fetch('/mastery-index.json');
      const data: MasteryIndex = await res.json();
      const states = loadStates();
      const progress = computeGroupProgress([...data.termGroups, ...data.knowledgeGroups], states);
      const mastered = new Set(progress.filter((g) => g.isFullyMastered).map((g) => g.key));
      document.querySelectorAll<HTMLElement>('[data-mastery-key]').forEach((el) => {
        const key = el.dataset.masteryKey;
        if (key && mastered.has(key)) el.hidden = false;
      });
    } catch {
      /* badges are decorative — fail quietly */
    }
  })();
</script>

<style>
  .sidebar {
    font-size: 0.86rem;
    padding-bottom: 3rem;
  }

  summary {
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }

  .nav-group {
    border-bottom: 1px solid var(--border);
    padding: 0.15rem 0;
  }
  .nav-group > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.25rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .nav-group > summary::before {
    content: '';
    width: 0;
    height: 0;
    border-left: 4px solid var(--brass);
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
  .nav-group[open] > summary::before {
    transform: rotate(90deg);
  }

  .nav-group-body {
    padding: 0.15rem 0 0.6rem 0.4rem;
  }

  .nav-hub-link {
    display: block;
    padding: 0.35rem 0.5rem;
    margin-bottom: 0.25rem;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    border-bottom: none;
  }
  .nav-hub-link:hover {
    text-decoration: underline;
  }

  .nav-subgroup {
    margin-left: 0.15rem;
  }
  .nav-subgroup > summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.5rem;
    color: var(--ink-muted);
    font-size: 0.78rem;
  }
  .nav-subgroup > summary::before {
    content: '›';
    display: inline-block;
    width: 0.7em;
    color: var(--brass);
    transition: transform 0.15s ease;
  }
  .nav-subgroup[open] > summary::before {
    transform: rotate(90deg);
  }

  .nav-subgroup ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0.4rem 1.4rem;
  }
  .nav-subgroup a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.4rem;
    border-radius: 3px;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: none;
    line-height: 1.3;
  }
  .nav-subgroup a:hover {
    background: var(--bg-inset);
    color: var(--ink);
  }
  .nav-subgroup a[aria-current='page'] {
    background: var(--bg-inset);
    color: var(--accent);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .knowledge-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0.4rem 0.15rem;
  }
  .knowledge-list a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.4rem;
    border-radius: 3px;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: none;
    line-height: 1.3;
  }
  .knowledge-list a:hover {
    background: var(--bg-inset);
    color: var(--ink);
  }
  .knowledge-list a[aria-current='page'] {
    background: var(--bg-inset);
    color: var(--accent);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .known-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--brass);
    flex-shrink: 0;
  }

  .sidebar-mastery-badge {
    margin-left: auto;
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }
  .sidebar-mastery-badge :global(.pixel-icon) {
    color: var(--brass);
  }
</style>
