---
import { PIXEL_ICONS, type PixelIconName } from '../../lib/pixelIcons';

interface Props {
  name: PixelIconName | string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const grid = PIXEL_ICONS[name] ?? PIXEL_ICONS.book;

const cells: { x: number; y: number }[] = [];
grid.forEach((row, y) => {
  row.split('').forEach((cell, x) => {
    if (cell === '1') cells.push({ x, y });
  });
});
---

<svg
  width={size}
  height={size}
  viewBox="0 0 8 8"
  shape-rendering="crispEdges"
  class:list={['pixel-icon', className]}
  aria-hidden="true"
>
  {cells.map((c) => (
    <rect x={c.x} y={c.y} width="1" height="1" fill="currentColor" />
  ))}
</svg>
