---
import PixelIcon from './ornaments/PixelIcon.astro';
---

<header class="site-header">
  <div class="site-header-row">
    <button id="mobile-nav-toggle" class="mobile-nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <a class="wordmark" href="/">
      <img class="wordmark-logo" src="/images/learnitas.png" alt="" width="37" height="44" />
      <span class="wordmark-text">Learnitas</span>
    </a>

    <div class="search-slot">
      <PixelIcon name="search" size={13} class="search-icon" />
      <input
        id="site-search-input"
        class="search-input"
        type="search"
        placeholder="Search the archive…"
        aria-label="Search"
      />
      <kbd class="search-kbd">/</kbd>
      <div id="search" class="search-results"></div>
    </div>

    <div class="toolbar-group">
      <a id="graph-link-btn" href="/graph" class="tool-btn" aria-label="Knowledge graph" data-tooltip="Knowledge graph" data-tooltip-pos="bottom">
        <PixelIcon name="graph" size={16} />
      </a>

      <a id="review-link-btn" href="/review" class="tool-btn" aria-label="Flashcard review" data-tooltip="Review flashcards" data-tooltip-pos="bottom">
        <PixelIcon name="check" size={16} />
        <span id="review-due-count" class="tool-badge" hidden>0</span>
      </a>

      <button id="random-note-btn" class="tool-btn" type="button" aria-label="Open a random note" data-tooltip="Surprise me" data-tooltip-pos="bottom">
        <PixelIcon name="dice" size={16} />
      </button>

      <!-- Study Assistant trigger — the panel it opens and the voice-mode
           logic (mic/speaker/spinner icon swap below, data-ai-state driven
           animation in this file's <style>) live in StudyAssistant.astro,
           wired up by element id, not by DOM nesting. -->
      <button
        id="assistant-toggle-btn"
        class="tool-btn"
        type="button"
        aria-label="Open Study Assistant"
        aria-expanded="false"
        data-tooltip="Study Assistant"
        data-tooltip-pos="bottom"
      >
        <span class="assistant-fab-icon" id="fab-icon-chat">
          <PixelIcon name="chat" size={16} />
        </span>
        <span class="assistant-fab-icon" id="fab-icon-mic" hidden>
          <PixelIcon name="mic" size={16} />
        </span>
        <span class="assistant-fab-icon" id="fab-icon-speaker" hidden>
          <PixelIcon name="speaker" size={16} />
        </span>
        <span class="assistant-fab-icon" id="fab-icon-spinner" hidden>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2.2"
              stroke-linecap="round" stroke-dasharray="38" stroke-dashoffset="10"/>
          </svg>
        </span>
      </button>

      <button
        id="command-palette-btn"
        class="tool-btn tool-btn-text"
        type="button"
        aria-label="Command palette"
        data-tooltip="Command palette (Ctrl+K)"
        data-tooltip-pos="bottom"
      >
        ⌘K
      </button>

      <div class="tool-popover-wrap">
        <button
          id="bookmarks-btn"
          class="tool-btn"
          type="button"
          aria-label="Bookmarks"
          aria-expanded="false"
          data-tooltip="Your bookmarked notes"
          data-tooltip-pos="bottom"
        >
          <PixelIcon name="star" size={16} />
          <span id="bookmarks-count" class="tool-badge" hidden>0</span>
        </button>
        <div id="bookmarks-panel" class="tool-panel" hidden>
          <p class="tool-panel-title font-pixel">Bookmarks</p>
          <div id="bookmarks-list" class="tool-panel-list"></div>
        </div>
      </div>

      <div class="tool-popover-wrap">
        <button
          id="text-size-btn"
          class="tool-btn tool-btn-text"
          type="button"
          aria-label="Text size"
          aria-expanded="false"
          data-tooltip="Reading text size"
          data-tooltip-pos="bottom"
        >
          Aa
        </button>
        <div id="text-size-panel" class="tool-panel tool-panel-narrow" hidden>
          <button class="text-size-option" data-size="sm">Small</button>
          <button class="text-size-option" data-size="md">Medium</button>
          <button class="text-size-option" data-size="lg">Large</button>
        </div>
      </div>

      <button
        id="crt-toggle-btn"
        class="tool-btn"
        type="button"
        aria-label="Toggle retro CRT mode"
        aria-pressed="false"
        data-tooltip="Retro CRT mode"
        data-tooltip-pos="bottom"
      >
        <PixelIcon name="tv" size={16} />
      </button>

      <button
        id="ipad-mode-toggle-btn"
        class="tool-btn"
        type="button"
        aria-label="Toggle iPad mode"
        aria-pressed="false"
        data-tooltip="iPad mode"
        data-tooltip-pos="bottom"
      >
        <PixelIcon name="tablet" size={16} />
      </button>

      <button
        id="navbar-hide-btn"
        class="tool-btn"
        type="button"
        aria-label="Hide navbar"
        aria-pressed="false"
        data-tooltip="Hide navbar"
        data-tooltip-pos="bottom"
      >
        <PixelIcon name="chevronUp" size={14} />
      </button>

      <!-- Trigger only — the modal it opens lives in SettingsModal.astro,
           wired up by element id, same pattern as #assistant-toggle-btn and
           #auth-toggle-btn above. -->
      <button
        id="settings-toggle-btn"
        class="tool-btn"
        type="button"
        aria-label="Settings"
        aria-expanded="false"
        data-tooltip="Settings"
        data-tooltip-pos="bottom"
      >
        <PixelIcon name="gear" size={16} />
      </button>
    </div>

    <p class="latin-motto" data-tooltip="Dare to know" data-tooltip-pos="bottom">Sapere Aude</p>

    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Switch between cream and dark reading mode"
      data-tooltip="Cream / Dark reading mode"
      data-tooltip-pos="bottom"
    >
      <PixelIcon name="sun" size={16} class="icon-sun" />
      <PixelIcon name="moon" size={16} class="icon-moon" />
    </button>

    <a href="/about" class="tool-btn about-btn" aria-label="About Learnitas" data-tooltip="About Learnitas" data-tooltip-pos="bottom">
      <PixelIcon name="info" size={16} />
    </a>

    <!-- Trigger only — the modal it opens, the sign-in/sign-up form, and the
         label-swap ("Log in" <-> signed-in email) all live in
         AuthModal.astro, wired up by element id, same pattern as
         #assistant-toggle-btn above. -->
    <button
      id="auth-toggle-btn"
      class="tool-btn auth-toggle-btn"
      type="button"
      aria-label="Log in"
      data-tooltip="Log in"
      data-tooltip-pos="bottom"
    >Log in</button>

    <!-- Toggles the secondary panel on the right — dispatches to
         BaseLayout.astro's open/closeSecondaryPanel via a custom event,
         same bridge #command-palette-btn already uses to reach a handler
         defined in a different file's <script>. -->
    <button
      id="secondary-panel-toggle-btn"
      class="tool-btn"
      type="button"
      aria-label="Toggle secondary panel"
      aria-pressed="false"
      data-tooltip="Toggle secondary panel"
      data-tooltip-pos="bottom"
    >
      <PixelIcon name="sidebar" size={16} />
    </button>

    <!-- Mobile-only: everything in .toolbar-group is hidden at <=640px (see
         that media query below) in favor of this one button. Its panel
         doesn't duplicate their behavior — each row delegates (.click()) to
         the real, still-present-but-hidden button, so there's exactly one
         source of truth for every action's logic. -->
    <div class="tool-popover-wrap more-tools-wrap">
      <button
        id="more-tools-btn"
        class="tool-btn more-tools-btn"
        type="button"
        aria-label="More tools"
        aria-expanded="false"
        data-tooltip="More tools"
        data-tooltip-pos="bottom"
      >
        <PixelIcon name="dots" size={16} />
      </button>
      <div id="more-tools-panel" class="tool-panel more-tools-panel" hidden>
        <a href="/graph" class="more-tools-row">
          <PixelIcon name="graph" size={14} /> <span>Knowledge graph</span>
        </a>
        <a href="/review" class="more-tools-row">
          <PixelIcon name="check" size={14} /> <span>Flashcard review</span>
        </a>
        <button type="button" class="more-tools-row" data-delegate="random-note-btn">
          <PixelIcon name="dice" size={14} /> <span>Random note</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="assistant-toggle-btn">
          <PixelIcon name="chat" size={14} /> <span>Study Assistant</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="command-palette-btn">
          <span class="more-tools-row-glyph">⌘K</span> <span>Command palette</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="bookmarks-btn">
          <PixelIcon name="star" size={14} /> <span>Bookmarks</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="text-size-btn">
          <span class="more-tools-row-glyph">Aa</span> <span>Text size</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="crt-toggle-btn">
          <PixelIcon name="tv" size={14} /> <span>Retro CRT mode</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="ipad-mode-toggle-btn">
          <PixelIcon name="tablet" size={14} /> <span>iPad mode</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="navbar-hide-btn">
          <PixelIcon name="chevronUp" size={14} /> <span>Hide navbar</span>
        </button>
        <button type="button" class="more-tools-row" data-delegate="settings-toggle-btn">
          <PixelIcon name="gear" size={14} /> <span>Settings</span>
        </button>
        <p class="more-tools-motto">Sapere Aude</p>
      </div>
    </div>
  </div>
</header>

<script>
  import { getBookmarks, removeBookmark } from '../lib/bookmarks-client';
  import { getDueCount } from '../lib/srs-client';
  import { getPagefind } from '../lib/pagefind-client';
  import { getNotesIndex } from '../lib/notes-index-client';

  const reviewDueEl = document.getElementById('review-due-count');
  if (reviewDueEl) {
    const due = getDueCount();
    reviewDueEl.textContent = String(due);
    reviewDueEl.hidden = due === 0;
  }

  const KEY = 'learnitas-theme';
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  function apply(theme: string) {
    if (theme === 'light' || theme === 'dark') {
      root.setAttribute('data-theme', theme);
    } else {
      root.removeAttribute('data-theme');
    }
  }

  btn?.addEventListener('click', () => {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = root.getAttribute('data-theme') ?? (prefersDark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    apply(next);
    localStorage.setItem(KEY, next);
  });

  const input = document.getElementById('site-search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search');

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input) {
      e.preventDefault();
      input?.focus();
    }
    if (e.key === 'Escape' && document.activeElement === input) {
      input?.blur();
      if (resultsEl) resultsEl.innerHTML = '';
    }
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest?.('.search-slot') && resultsEl) {
      resultsEl.innerHTML = '';
    }
  });

  async function runSearch(query: string) {
    if (!resultsEl) return;
    // First search (or a slow connection) can take a moment: getPagefind()
    // lazily loads the whole search index. Show something immediately
    // rather than leaving the dropdown blank while that's in flight.
    resultsEl.innerHTML = '<p class="search-empty">Searching…</p>';
    const pagefind = await getPagefind();
    if (!pagefind) {
      resultsEl.innerHTML =
        '<p class="search-empty">Search is available once Learnitas is built for production (<code>npm run build</code>).</p>';
      return;
    }
    const search = await pagefind.search(query);
    const PREVIEW_CAP = 8;
    const items = await Promise.all(search.results.slice(0, PREVIEW_CAP).map((r) => r.data()));
    if (!items.length) {
      resultsEl.innerHTML = '<p class="search-empty">No matches in the archive.</p>';
      return;
    }
    const resultLinks = items
      .map(
        (item) => `
        <a class="search-result" href="${item.url}">
          <span class="search-result-title">${item.meta?.title ?? item.url}</span>
          <span class="search-result-excerpt">${item.excerpt}</span>
        </a>`,
      )
      .join('');
    const seeAll =
      search.results.length > PREVIEW_CAP
        ? `<a class="search-see-all" href="/search?q=${encodeURIComponent(query)}">See all ${search.results.length} results →</a>`
        : '';
    resultsEl.innerHTML = resultLinks + seeAll;
  }

  let debounceTimer: number | undefined;
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && input.value.trim()) {
      window.location.href = `/search?q=${encodeURIComponent(input.value.trim())}`;
    }
  });
  input?.addEventListener('input', () => {
    window.clearTimeout(debounceTimer);
    const value = input.value.trim();
    if (!resultsEl) return;
    if (!value) {
      resultsEl.innerHTML = '';
      return;
    }
    debounceTimer = window.setTimeout(() => runSearch(value), 150);
  });

  // ---------- Random note ----------
  const randomBtn = document.getElementById('random-note-btn') as HTMLButtonElement | null;
  randomBtn?.addEventListener('click', async () => {
    // Only the very first click is ever slow (the index fetch is memoized in
    // getNotesIndex, shared with the command palette's note search), but
    // that first one can still take a beat on a slow connection — a busy
    // state beats a click that looks like nothing.
    randomBtn.setAttribute('aria-busy', 'true');
    randomBtn.disabled = true;
    try {
      const list = await getNotesIndex();
      if (!list.length) return;
      const pick = list[Math.floor(Math.random() * list.length)];
      window.location.href = pick.url;
    } finally {
      randomBtn.removeAttribute('aria-busy');
      randomBtn.disabled = false;
    }
  });

  // ---------- Command palette trigger ----------
  document.getElementById('command-palette-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('learnitas:command-palette-open'));
  });

  // ---------- Popovers (bookmarks + text size) ----------
  const popovers: { btn: HTMLElement; panel: HTMLElement }[] = [];
  function registerPopover(btnId: string, panelId: string) {
    const b = document.getElementById(btnId);
    const p = document.getElementById(panelId);
    if (!b || !p) return;
    popovers.push({ btn: b, panel: p });
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !p.hidden;
      closeAllPopovers();
      if (!isOpen) {
        p.hidden = false;
        b.setAttribute('aria-expanded', 'true');
      }
    });
  }
  function closeAllPopovers() {
    for (const { btn: b, panel: p } of popovers) {
      p.hidden = true;
      b.setAttribute('aria-expanded', 'false');
    }
  }
  registerPopover('bookmarks-btn', 'bookmarks-panel');
  registerPopover('text-size-btn', 'text-size-panel');
  registerPopover('more-tools-btn', 'more-tools-panel');
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest?.('.tool-popover-wrap')) closeAllPopovers();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPopovers();
  });

  // ---------- Mobile "more tools" dropdown — delegates to the real buttons ----------
  // Every action-row here just re-clicks the actual button it stands in
  // for (still in the DOM, hidden at this breakpoint rather than removed),
  // so there's exactly one implementation of each action's logic — this
  // never duplicates it. Closing this dropdown first (closeAllPopovers)
  // means it's out of the way before the delegate's own handler runs,
  // whether or not that handler is itself part of the popover system.
  document.querySelectorAll<HTMLElement>('#more-tools-panel [data-delegate]').forEach((row) => {
    row.addEventListener('click', () => {
      const targetId = row.dataset.delegate;
      closeAllPopovers();
      if (targetId) document.getElementById(targetId)?.click();
    });
  });

  // ---------- Bookmarks panel ----------
  function renderBookmarks() {
    const list = getBookmarks();
    const countEl = document.getElementById('bookmarks-count');
    const listEl = document.getElementById('bookmarks-list');
    if (countEl) {
      countEl.textContent = String(list.length);
      countEl.hidden = list.length === 0;
    }
    if (!listEl) return;
    if (!list.length) {
      listEl.innerHTML = '<p class="tool-panel-empty">Star a note while reading to save it here.</p>';
      return;
    }
    listEl.innerHTML = list
      .map(
        (b) => `
        <div class="bookmark-row">
          <a href="${b.url}">${b.title}</a>
          <button type="button" class="bookmark-remove" data-url="${b.url}" aria-label="Remove bookmark">×</button>
        </div>`,
      )
      .join('');
    listEl.querySelectorAll<HTMLButtonElement>('.bookmark-remove').forEach((rmBtn) => {
      rmBtn.addEventListener('click', () => {
        const url = rmBtn.dataset.url;
        if (url) removeBookmark(url);
      });
    });
  }
  document.addEventListener('learnitas:bookmarks-changed', renderBookmarks);
  renderBookmarks();

  // ---------- Text size ----------
  const SIZE_KEY = 'learnitas-text-size';
  document.querySelectorAll<HTMLButtonElement>('.text-size-option').forEach((opt) => {
    opt.addEventListener('click', () => {
      const size = opt.dataset.size;
      if (size === 'md') {
        root.removeAttribute('data-text-size');
        localStorage.removeItem(SIZE_KEY);
      } else if (size) {
        root.setAttribute('data-text-size', size);
        localStorage.setItem(SIZE_KEY, size);
      }
      closeAllPopovers();
    });
  });

  // ---------- Retro CRT toggle ----------
  const CRT_KEY = 'learnitas-crt';
  const crtBtn = document.getElementById('crt-toggle-btn');
  crtBtn?.setAttribute('aria-pressed', root.getAttribute('data-crt') === 'on' ? 'true' : 'false');
  crtBtn?.addEventListener('click', () => {
    const on = root.getAttribute('data-crt') === 'on';
    if (on) {
      root.removeAttribute('data-crt');
      localStorage.removeItem(CRT_KEY);
    } else {
      root.setAttribute('data-crt', 'on');
      localStorage.setItem(CRT_KEY, 'on');
    }
    crtBtn.setAttribute('aria-pressed', String(!on));
  });

  // ---------- Secondary panel toggle (navbar) ----------
  // Open/closeSecondaryPanel live in BaseLayout.astro's own <script> — a
  // separate module from this one — so this reaches them the same way
  // #command-palette-btn reaches CommandPalette.astro: a custom event.
  // A MutationObserver (not a handful of specific event listeners) keeps
  // aria-pressed accurate regardless of which of the panel's several close
  // paths fired (X button, backdrop click, Escape, or this button itself).
  const secondaryToggleBtn = document.getElementById('secondary-panel-toggle-btn');
  function syncSecondaryToggleBtn() {
    secondaryToggleBtn?.setAttribute('aria-pressed', String(root.getAttribute('data-secondary-panel') === 'open'));
  }
  syncSecondaryToggleBtn();
  secondaryToggleBtn?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('learnitas:secondary-panel-toggle'));
  });
  new MutationObserver(syncSecondaryToggleBtn).observe(root, {
    attributes: true,
    attributeFilter: ['data-secondary-panel'],
  });

  // ---------- iPad mode toggle ----------
  // Same shape as the CRT toggle above: flips a [data-ipad-mode] attribute
  // that global.css / AnnotationCanvas.astro key off of, persisted the same
  // way. BaseLayout.astro's inline head script restores this before paint.
  const IPAD_KEY = 'learnitas-ipad-mode';
  const ipadBtn = document.getElementById('ipad-mode-toggle-btn');
  ipadBtn?.setAttribute('aria-pressed', root.getAttribute('data-ipad-mode') === 'on' ? 'true' : 'false');
  ipadBtn?.addEventListener('click', () => {
    const on = root.getAttribute('data-ipad-mode') === 'on';
    if (on) {
      root.removeAttribute('data-ipad-mode');
      localStorage.removeItem(IPAD_KEY);
    } else {
      root.setAttribute('data-ipad-mode', 'on');
      localStorage.setItem(IPAD_KEY, 'on');
    }
    ipadBtn.setAttribute('aria-pressed', String(!on));
    document.dispatchEvent(new CustomEvent('learnitas:ipad-mode-changed', { detail: { on: !on } }));
  });
</script>

<style>
  /* The header collapses via a max-height transition, capped generously above
     its real content height (~60px) so it never clips while shown.
     `overflow` itself is only `hidden` while actively animating — settling
     back to `visible` 0.32s after becoming fully shown (and flipping to
     `hidden` immediately when starting to hide) — otherwise it would
     permanently clip anything that pops out below its own box, like the
     tooltips and the search-results dropdown. Same delayed-switch trick as
     `visibility` below, just in the opposite direction. */
  .site-header {
    overflow: visible;
    max-height: 300px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
    position: sticky;
    top: 0;
    z-index: 40;
    transition: max-height 0.32s ease, border-color 0.32s ease, visibility 0s linear 0s,
      overflow 0s linear 0.32s;
  }
  :global([data-navbar='hidden']) .site-header {
    max-height: 0;
    overflow: hidden;
    border-bottom-color: transparent;
    visibility: hidden;
    transition: max-height 0.32s ease, border-color 0.32s ease, visibility 0s linear 0.32s,
      overflow 0s linear 0s;
  }

  .site-header-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.7rem 1.75rem;
  }

  .mobile-nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 30px;
    height: 30px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    flex-shrink: 0;
    cursor: pointer;
  }
  .mobile-nav-toggle span {
    display: block;
    height: 2px;
    margin: 0 6px;
    background: var(--brass);
  }
  @media (max-width: 880px) {
    .mobile-nav-toggle {
      display: flex;
    }
    .search-slot {
      max-width: none;
    }
    .search-kbd {
      display: none;
    }
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
    opacity: 1;
    transition: opacity 0.14s ease;
  }
  /* Fades out quickly as the header starts collapsing (see .site-header's own
     longer transition) rather than being clipped mid-fade. Its counterpart,
     .sidebar-wordmark in BaseLayout, fades in over the same window so the
     brand reads as "settling into the sidebar" rather than just vanishing. */
  :global([data-navbar='hidden']) .wordmark {
    opacity: 0;
  }
  .wordmark-logo {
    display: block;
    height: 46px;
    width: auto;
    flex-shrink: 0;
    transform: translateY(-3px);
  }
  .wordmark-text {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .search-slot {
    position: relative;
    flex: 1;
    /* A flex item's automatic minimum width is its content's min-content
       size, and a bare <input> has a stubborn browser-default intrinsic
       width (historically ~170-200px) that resists shrinking below it —
       without this override, that alone can force the whole toolbar row
       wider than the viewport on a narrow phone regardless of how much
       else in the row is trimmed. */
    min-width: 0;
    max-width: 32rem;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 0.7rem;
    color: var(--ink-faint);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.45rem 2.2rem 0.45rem 2rem;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--ink);
    font-family: var(--font-body);
