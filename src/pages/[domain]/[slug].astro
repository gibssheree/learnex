---
import { getCollection, render } from 'astro:content';
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import { getBacklinksFor } from '../../lib/backlinks';

// Standalone knowledge domains (Chemistry, Physics, ...) each get a bare
// /<domain-slug>/<slug> route — no /terms prefix, no shared group crumb.
// Mirrors src/pages/terms/[domain]/[slug].astro but for the 'knowledge'
// collection, whose domains are disjoint top-level sections in their own
// right rather than Terms & Knowledge sub-domains.
export async function getStaticPaths() {
  const knowledge = await getCollection('knowledge');
  const notes = knowledge.filter((t) => !t.data.isMoc);

  const byDomain = new Map<string, typeof notes>();
  for (const n of notes) {
    if (!byDomain.has(n.data.domainSlug)) byDomain.set(n.data.domainSlug, []);
    byDomain.get(n.data.domainSlug)!.push(n);
  }
  for (const list of byDomain.values()) {
    list.sort((a, b) => a.data.title.localeCompare(b.data.title));
  }

  return notes.map((entry) => {
    const siblings = byDomain.get(entry.data.domainSlug)!;
    const idx = siblings.findIndex((s) => s.id === entry.id);
    return {
      params: { domain: entry.data.domainSlug, slug: entry.data.slug },
      props: {
        entry,
        prev: idx > 0 ? siblings[idx - 1] : undefined,
        next: idx < siblings.length - 1 ? siblings[idx + 1] : undefined,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);

const ownRoute = `/${entry.data.domainSlug}/${entry.data.slug}`;
const backlinks = await getBacklinksFor(ownRoute);
---

<ReaderLayout
  title={entry.data.title}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: entry.data.domain, href: `/${entry.data.domainSlug}` },
    { label: entry.data.title },
  ]}
  headings={headings}
  prev={prev && { title: prev.data.title, href: `/${entry.data.domainSlug}/${prev.data.slug}` }}
  next={next && { title: next.data.title, href: `/${entry.data.domainSlug}/${next.data.slug}` }}
  backlinks={backlinks}
>
  <Content />
</ReaderLayout>
