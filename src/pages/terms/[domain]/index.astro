---
import { getCollection, render } from 'astro:content';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import { DOMAIN_GROUPS } from '../../../lib/domainGroups';
import { slugify } from '../../../lib/vault';

export async function getStaticPaths() {
  const terms = await getCollection('terms');
  const mocs = terms.filter((t) => t.data.isMoc);
  return mocs.map((entry) => ({
    params: { domain: entry.data.domainSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const groupTitle = DOMAIN_GROUPS.find((g) => g.domains.includes(entry.data.domain))?.title;

const terms = await getCollection('terms');
const noteCount = terms.filter((t) => t.data.domainSlug === entry.data.domainSlug && !t.data.isMoc).length;
---

<ReaderLayout
  title={entry.data.domain}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: groupTitle ?? 'Terms & Knowledge', href: groupTitle ? `/terms#${slugify(groupTitle)}` : '/terms' },
    { label: entry.data.domain },
  ]}
  headings={headings}
>
  <p class="hub-kicker font-pixel">{noteCount} notes in this chapter</p>
  <Content />
</ReaderLayout>

<style>
  .hub-kicker {
    font-size: 0.62rem;
    color: var(--brass);
    letter-spacing: 0.04em;
    margin: -0.4em 0 1.6em;
  }
</style>
